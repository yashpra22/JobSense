# =====================================================================
# JobSense Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# =====================================================================

# NVIDIA NIM / OpenAI API Key (Required for LLM Job Evaluation & Auto-Apply)
# Obtain a free key at: https://build.nvidia.com
NVIDIA_API_KEY="nvapi-your-key-here"

# LLM Provider Configuration
# Options: "nvidia", "ollama", "openai"
LLM_PROVIDER="nvidia"
LLM_MODEL="meta/llama-3.1-70b-instruct"

# Auto-Apply Configuration
# Default: False (Submits real applications). Set to True for testing form fills.
DRY_RUN=False

# Optional Email Notification Settings (For Real-Time Job Match Alerts & Daily Digests)
EMAIL_FROM="your-email@gmail.com"
EMAIL_TO="recipient-email@gmail.com"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
