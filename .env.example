# JobSense environment template. Copy to .env and keep .env private.

# Dashboard security
DASHBOARD_PASSWORD="change-this-local-password"
DASHBOARD_SECRET_KEY="replace-with-a-long-random-secret"
DASHBOARD_PORT=5000

# LLM
NVIDIA_API_KEY="nvapi-your-key-here"
LLM_PROVIDER="ollama"
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="gpt-oss:120b-cloud"

# Auto-apply safety
# Dry-run is the default. Real submission additionally requires JOBSENSE_LIVE_APPLY=true.
DRY_RUN=true
JOBSENSE_LIVE_APPLY=false
APPLY_SCORE_THRESHOLD=80
MAX_JOBS_PER_RUN=1
HEADLESS=false

# Candidate profile (private; do not commit actual values)
CANDIDATE_FULL_NAME="Your Name"
CANDIDATE_FIRST_NAME="Your"
CANDIDATE_LAST_NAME="Name"
CANDIDATE_EMAIL="you@example.com"
CANDIDATE_PHONE="+91-XXXXXXXXXX"
CANDIDATE_CITY="Noida"
CANDIDATE_STATE="Uttar Pradesh"
CANDIDATE_COUNTRY="India"
CANDIDATE_POSTAL_CODE=""
CANDIDATE_YEARS_EXPERIENCE="0"
CANDIDATE_CURRENT_COMPANY=""
CANDIDATE_CURRENT_TITLE=""
CANDIDATE_HIGHEST_DEGREE="Bachelor of Technology"
CANDIDATE_FIELD_OF_STUDY="Computer Science & Engineering"
CANDIDATE_UNIVERSITY=""
CANDIDATE_GRADUATION_YEAR=""
CANDIDATE_LINKEDIN=""
CANDIDATE_GITHUB=""
CANDIDATE_PORTFOLIO=""
RESUME_PDF_PATH="/absolute/path/to/resume.pdf"
CANDIDATE_WILLING_TO_RELOCATE=true
CANDIDATE_VISA_SPONSORSHIP_NEEDED=false
CANDIDATE_US_AUTHORIZED=false
CANDIDATE_AUTHORIZED_TO_WORK=true
CANDIDATE_WHY_THIS_COMPANY=""
CANDIDATE_GREATEST_STRENGTH=""
CANDIDATE_SUMMARY=""
CANDIDATE_SALARY_EXPECTATION=""

# Email notifications (optional)
EMAIL_FROM=""
EMAIL_TO=""
SMTP_USER=""
SMTP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
